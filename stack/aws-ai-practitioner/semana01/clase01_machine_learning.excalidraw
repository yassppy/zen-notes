    {
      "id": "ZEn9bJgUSXT20id8CR5RF",
      "type": "text",
      "x": 3402.0374290829604,
      "y": 286.19653015136686,
      "width": 485.79937744140625,
      "height": 81,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ap",
      "roundness": null,
      "seed": 341206457,
      "version": 651,
      "versionNonce": 107179737,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791508879040,
      "link": null,
      "locked": false,
      "text": "Una vez que el modelo ya ha sido entrenado\nse le llama \"inferencia\" cuando el modelo ya esta listo\npara salir al mundo real",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Una vez que el modelo ya ha sido entrenado\nse le llama \"inferencia\" cuando el modelo ya esta listo\npara salir al mundo real",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "WEJxjHekQDn6UHJ-3CSwy",
      "type": "text",
      "x": 3372.4819132486978,
      "y": 531.2853982107977,
      "width": 484.27935791015625,
      "height": 243,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "au",
      "roundness": null,
      "seed": 1941255993,
      "version": 731,
      "versionNonce": 2075906361,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791508881039,
      "link": null,
      "locked": false,
      "text": "Inferencia por lotes: \n- Grandes volúmenes de datos procesados juntos,\nideal cuando no urge la respuesta y se puede esperar.\n\nInferencia en tiempo real\n- Es fundamental en aplicaciones donde se necesita\n una respuesta inmediata, como un chatbot que \nte responde al escribir o un vehículo autónomo \nque debe frenar de emergencia",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Inferencia por lotes: \n- Grandes volúmenes de datos procesados juntos,\nideal cuando no urge la respuesta y se puede esperar.\n\nInferencia en tiempo real\n- Es fundamental en aplicaciones donde se necesita\n una respuesta inmediata, como un chatbot que \nte responde al escribir o un vehículo autónomo \nque debe frenar de emergencia",
      "autoResize": true,
      "lineHeight": 1.35
    },
